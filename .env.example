# --- Digients preview portal config ---
# Copy to `.env` (gitignored) and fill in. The server reads these at boot.

# Shared password the client types to enter the portal.
# Falls back to "digients-demo" in non-production with a warning if unset.
PREVIEW_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A random per-boot value is used if unset (sessions reset on restart).
SESSION_SECRET=

# Port the server listens on (default 8787).
PORT=8787

# Directory holding preview video files (default: <repo>/videos).
# VIDEOS_DIR=/var/lib/digients-preview/videos

# Path to the built frontend, relative to the server's working dir (default: ../web/dist).
# Only used in production; in dev the Vite dev server serves the frontend.
# STATIC_ROOT=../web/dist
