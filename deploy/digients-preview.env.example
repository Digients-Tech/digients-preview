# Copied to /etc/digients-preview.env by setup.sh (chmod 600, not in git).
# Edit the secrets, then: sudo systemctl restart digients-preview

# Shared password clients type to enter the portal. REQUIRED in production.
PREVIEW_PASSWORD=change-me-to-something-strong

# Cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars

# Port the Node server listens on (Caddy proxies to this).
PORT=8787

# Optional: override where preview videos live (default: <repo>/videos).
# VIDEOS_DIR=/var/lib/digients-preview/videos
