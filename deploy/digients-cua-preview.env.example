# CUA has one production site, with no staging site.
NODE_ENV=production
PORT=8789
CUA_DATA_DIR=/opt/digients-preview-data/cua-zbrush-REVISION
STATS_PATH=/opt/digients-preview-data/cua-state/login-counts.json
# Use an independently generated session secret, never commit the real value.
SESSION_SECRET=replace-with-a-random-secret
# PREVIEW_PASSWORD is inherited from /etc/digients-preview.env by the service.
# Do not add PREVIEW_PASSWORD here; passwords must stay aligned with sample.
