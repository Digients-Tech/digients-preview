# Secrets
.env
.env.local
*.env

# Packages
node_modules/
**/node_modules/

# Build
web/dist/
server/dist/
.vite/

# Data
# Preview videos + generated poster frames live on the server disk, not in git
# (regenerate via `pnpm gen:samples` and `pnpm gen:posters`)
videos/*
!videos/.gitkeep
posters/
captions/
# Source-backed L4 delivery assets and generated catalogue (private runtime data)
data/l4-*/
# Client delivery staging (hardlinked subset for Google Drive hand-off)
delivery-web36/
delivery-*/

# Runtime state — login counts per password slot
.stats/

# Cache
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# Tooling
.claude/
.impeccable/review/

# Python data preparation bytecode
__pycache__/
